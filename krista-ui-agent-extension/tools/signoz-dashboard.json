              "aggregateOperator": "sum",
              "aggregateAttribute": {
                "key": "selector.cache.hits",
                "type": "Sum",
                "isMonotonic": true
              },
              "legend": "hits"
            },
            {
              "queryName": "B",
              "dataSource": "metrics",
              "aggregateOperator": "sum",
              "aggregateAttribute": {
                "key": "selector.cache.misses",
                "type": "Sum",
                "isMonotonic": true
              },
              "legend": "misses"
            }
          ],
          "formulaData": [
            {
              "expression": "A * 100 / (A + B)",
              "queryName": "F1",
              "legend": "cache_hit_rate_%"
            }
          ]
        }
