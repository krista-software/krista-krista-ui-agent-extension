  "widgets": [
    {
      "id": "prompt_throughput",
      "title": "Prompt Executions / min",
      "description": "Rate of prompt executions by status",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateAttribute": {
                "key": "uiagent.prompt.executions",
                "type": "Sum",
                "isMonotonic": true
              },
              "groupBy": [
                {
                  "key": "status",
                  "type": "tag"
                }
              ],
              "legend": "{{status}}",
              "reduceTo": "last",
              "aggregateOperator": "rate"
            }
          ]
        }
      }
    },
    {
      "id": "prompt_error_rate",
      "title": "Prompt Error Rate %",
      "description": "Percentage of prompt executions that failed",
      "panelTypes": "value",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "sum",
              "aggregateAttribute": {
                "key": "uiagent.prompt.errors",
                "type": "Sum",
                "isMonotonic": true
              },
              "legend": "errors"
            },
            {
              "queryName": "B",
              "dataSource": "metrics",
              "aggregateOperator": "sum",
              "aggregateAttribute": {
                "key": "uiagent.prompt.executions",
                "type": "Sum",
                "isMonotonic": true
              },
              "legend": "total"
            }
          ],
          "formulaData": [
            {
              "expression": "A * 100 / B",
              "queryName": "F1",
              "legend": "error_rate_%"
            }
          ]
        }
      }
    },
